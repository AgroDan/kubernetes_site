{
  "title": "Kubernetes Prod - Traffic & Health",
  "uid": "k8s-prod-traffic",
  "tags": [
    "kubernetes-prod",
    "traefik"
  ],
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "name": "ds",
        "label": "Logs data source",
        "type": "datasource",
        "query": "loki",
        "regex": ".*-logs$",
        "current": {},
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Overview (for the selected time range)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Requests",
      "description": "Total HTTP requests across all sites.",
      "datasource": {
        "type": "loki",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${ds}"
          },
          "expr": "sum(count_over_time({namespace=\"traefik\"} |= \"ClientHost\" | json | __error__=\"\" | ClientHost != \"\" [$__range]))",
          "queryType": "instant",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Unique visitor IPs",
      "description": "Number of distinct client IP addresses.",
      "datasource": {
        "type": "loki",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${ds}"
          },
          "expr": "count(sum by (ClientHost) (count_over_time({namespace=\"traefik\"} |= \"ClientHost\" | json | __error__=\"\" | ClientHost != \"\" [$__range])))",
          "queryType": "instant",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "purple",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Server errors (5xx)",
      "description": "Requests that failed with a 5xx status. Should be 0.",
      "datasource": {
        "type": "loki",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${ds}"
          },
          "expr": "sum(count_over_time({namespace=\"traefik\"} |= \"ClientHost\" | json | __error__=\"\" | ClientHost != \"\" | DownstreamStatus >= 500 [$__range]))",
          "queryType": "instant",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Cluster warnings",
      "description": "Kubernetes warning events: failed health checks, OOM kills, restarts, image pull errors.",
      "datasource": {
        "type": "loki",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${ds}"
          },
          "expr": "sum(count_over_time({job=\"integrations/kubernetes/eventhandler\"} | level=\"Warning\" [$__range]))",
          "queryType": "instant",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "row",
      "title": "Traffic",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Requests per site",
      "description": "How busy each site is over time. A sudden spike here is what a flood/DoS looks like.",
      "datasource": {
        "type": "loki",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${ds}"
          },
          "expr": "sum by (RequestHost) (count_over_time({namespace=\"traefik\"} |= \"ClientHost\" | json | __error__=\"\" | ClientHost != \"\" [$__auto]))",
          "legendFormat": "{{RequestHost}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Responses by status",
      "description": "2xx = success, 3xx = redirects, 4xx = bad requests/not found (often bots/scanners), 5xx = your site failing.",
      "datasource": {
        "type": "loki",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${ds}"
          },
          "expr": "sum(count_over_time({namespace=\"traefik\"} |= \"ClientHost\" | json | __error__=\"\" | ClientHost != \"\" | DownstreamStatus < 300 [$__auto]))",
          "legendFormat": "2xx OK"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "${ds}"
          },
          "expr": "sum(count_over_time({namespace=\"traefik\"} |= \"ClientHost\" | json | __error__=\"\" | ClientHost != \"\" | DownstreamStatus >= 300 | DownstreamStatus < 400 [$__auto]))",
          "legendFormat": "3xx redirect"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "loki",
            "uid": "${ds}"
          },
          "expr": "sum(count_over_time({namespace=\"traefik\"} |= \"ClientHost\" | json | __error__=\"\" | ClientHost != \"\" | DownstreamStatus >= 400 | DownstreamStatus < 500 [$__auto]))",
          "legendFormat": "4xx client error"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "loki",
            "uid": "${ds}"
          },
          "expr": "sum(count_over_time({namespace=\"traefik\"} |= \"ClientHost\" | json | __error__=\"\" | ClientHost != \"\" | DownstreamStatus >= 500 [$__auto]))",
          "legendFormat": "5xx server error"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "2xx OK"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "3xx redirect"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "4xx client error"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "5xx server error"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Response time (95th percentile)",
      "description": "95% of requests were faster than this. Rising response times often come before an outage.",
      "datasource": {
        "type": "loki",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${ds}"
          },
          "expr": "quantile_over_time(0.95, {namespace=\"traefik\"} |= \"ClientHost\" | json | __error__=\"\" | ClientHost != \"\" | unwrap Duration | __error__=\"\" [$__auto]) by (RequestHost) / 1000000",
          "legendFormat": "{{RequestHost}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Cluster warnings by reason",
      "description": "Unhealthy = failed health check, Killing = container restarted, SystemOOM/OOMKilling = out of memory, BackOff = crash loop.",
      "datasource": {
        "type": "loki",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${ds}"
          },
          "expr": "sum by (reason) (count_over_time({job=\"integrations/kubernetes/eventhandler\"} | level=\"Warning\" [$__auto]))",
          "legendFormat": "{{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "type": "row",
      "title": "Who is hitting what",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 12,
      "type": "bargauge",
      "title": "Top client IPs",
      "description": "The IP addresses sending the most requests. One IP far above the rest is worth investigating.",
      "datasource": {
        "type": "loki",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${ds}"
          },
          "expr": "topk(10, sum by (ClientHost) (count_over_time({namespace=\"traefik\"} |= \"ClientHost\" | json | __error__=\"\" | ClientHost != \"\" [$__range])))",
          "queryType": "instant",
          "instant": true,
          "legendFormat": "{{ClientHost}}"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "continuous-BlYlRd"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "type": "bargauge",
      "title": "Top pages",
      "description": "Most requested paths across all sites.",
      "datasource": {
        "type": "loki",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 8,
        "y": 23,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${ds}"
          },
          "expr": "topk(10, sum by (RequestPath) (count_over_time({namespace=\"traefik\"} |= \"ClientHost\" | json | __error__=\"\" | ClientHost != \"\" [$__range])))",
          "queryType": "instant",
          "instant": true,
          "legendFormat": "{{RequestPath}}"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "continuous-BlYlRd"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 14,
      "type": "bargauge",
      "title": "Top user agents",
      "description": "Browsers, bots and tools making requests. Scanners and scrapers show up here.",
      "datasource": {
        "type": "loki",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 16,
        "y": 23,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${ds}"
          },
          "expr": "topk(10, sum by (request_User_Agent) (count_over_time({namespace=\"traefik\"} |= \"ClientHost\" | json | __error__=\"\" | ClientHost != \"\" [$__range])))",
          "queryType": "instant",
          "instant": true,
          "legendFormat": "{{request_User_Agent}}"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "continuous-BlYlRd"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 15,
      "type": "row",
      "title": "Logs",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 16,
      "type": "logs",
      "title": "Live access log",
      "description": "Every request, newest first. Click a line to see all of its fields.",
      "datasource": {
        "type": "loki",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${ds}"
          },
          "expr": "{namespace=\"traefik\"} |= \"ClientHost\" | json | __error__=\"\" | ClientHost != \"\" | line_format \"{{.ClientHost}}  {{.RequestMethod}} {{.RequestHost}}{{.RequestPath}}  ->  {{.DownstreamStatus}}  ({{div .Duration 1000000}}ms)  {{.request_User_Agent}}\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    },
    {
      "id": 17,
      "type": "logs",
      "title": "Server errors (5xx)",
      "description": "Requests your sites failed to serve.",
      "datasource": {
        "type": "loki",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 43,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${ds}"
          },
          "expr": "{namespace=\"traefik\"} |= \"ClientHost\" | json | __error__=\"\" | ClientHost != \"\" | DownstreamStatus >= 500",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    },
    {
      "id": 18,
      "type": "logs",
      "title": "Kubernetes warnings",
      "description": "Warning events from the cluster: crashes, OOM kills, failed health checks.",
      "datasource": {
        "type": "loki",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 12,
        "y": 43,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${ds}"
          },
          "expr": "{job=\"integrations/kubernetes/eventhandler\"} | level=\"Warning\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    }
  ]
}